{
  "name": "bnecleaners",
  "version": "1.0.0",
  "description": "Web SPA for BNE Cleaners",
  "scripts": {
    "dev": "pnpm parcel index.html static/images/*.jpg static/images/*.png static/icons/*.svg static/*.css",
    "build": "rm -rf dist/ && pnpm parcel build index.html && cp -r static/ dist/",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@parcel/transformer-elm": "2.16.4",
    "@parcel/transformer-less": "2.16.4",
    "elm": "0.19.1-6",
    "parcel": "^2.16.4",
    "wrangler": "^4.135.0"
  }
}
